# Environment variables. Copy to `.env` and fill in real values.
#
# This file is not exhaustive — it documents the settings whose absence or
# misconfiguration is a security problem. See `src/config.py` for the full set.


# ── Admin panel JWT ────────────────────────────────────────────────────────
#
# REQUIRED. Signs the admin JWT that guards every RBAC-protected endpoint,
# including payment processing. The application refuses to start if this is
# missing, shorter than 32 characters, or left at a placeholder value: booting
# on a guessable secret would let anyone forge a `role: "super-admin"` token.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating it invalidates every issued admin token — all admins must log in
# again.
API_JWT_SECRET=

# Optional. Defaults to HS256.
# API_JWT_ALGORITHM=HS256

# Optional. Admin JWT lifetime in minutes; defaults to 480 (8 hours).
# Deactivation and role changes take effect within seconds regardless of this
# value, so it does not need to be short for revocation to work.
# API_JWT_EXPIRE_MINUTES=480

# Required for the WebAuthn/passkey endpoints, e.g. https://admin.example.com
# API_ADMIN_PANEL_ORIGIN=


# ── China partner import API ───────────────────────────────────────────────
#
# Static shared key for POST /api/v1/shipment/create. Share it with the partner
# out of band and never commit it.
#   python -c "import secrets; print(secrets.token_hex(32))"
API_CHINA_PARTNER_KEY=
